    4100 = # of frozen angles
  find clusters CPU = 0.001 seconds

# ============================================================
# STAGE 1 : 100 ps NVT re-thermalization  (fresh velocities, seed 101)
# ============================================================
velocity        all create 298.15 101 dist gaussian mom yes rot yes

fix             NVT all nvt temp 298.15 298.15 100.0

thermo          1000
thermo_style    custom step temp press pe ke etotal vol pxy pxz pyz
thermo_modify   flush yes
timestep        1.0

restart         50000 thermalize.restart1 thermalize.restart2
run             100000     # 100 ps

