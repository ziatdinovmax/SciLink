&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'si_bulk'
   pseudo_dir       = './'
/
&SYSTEM
   ecutwfc          = 50.0
   ecutrho          = 400.0
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'cold'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.7
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
