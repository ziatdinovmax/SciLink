# Dockerfile for SciLink with MD Analysis capabilities
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    libgomp1 \
    git \
    libgl1 \
    libglib2.0-0 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Install core scientific stack
RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    scipy==1.11.4 \
    matplotlib==3.8.2 \
    pandas==2.1.4 \
    seaborn==0.13.0

# Install MD analysis packages
RUN pip install --no-cache-dir \
    MDAnalysis==2.7.0 \
    nglview \
    plotly \
    statsmodels \
    scikit-learn

# Install LLM packages
RUN pip install --no-cache-dir \
    google-generativeai \
    openai \
    litellm

# Install ASE for structure handling
RUN pip install --no-cache-dir ase

# Install additional useful packages
RUN pip install --no-cache-dir \
    tqdm \
    pyyaml \
    requests

# Create non-root user
RUN useradd -m -u 1000 scilink && \
    mkdir -p /app/scilink && \
    chown -R scilink:scilink /app

USER scilink

# Set environment variables
ENV RUNNING_IN_CONTAINER=true \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg \
    OMP_NUM_THREADS=1

WORKDIR /app

CMD ["/bin/bash"]
