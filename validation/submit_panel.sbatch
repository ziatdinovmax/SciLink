#!/bin/bash
#SBATCH --job-name=validation_panel
#SBATCH --partition=a100_shared
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=12:00:00
#SBATCH --output=validation_%j.out
#SBATCH --error=validation_%j.err

# Drives the full lattice-constant validation panel across all three
# benchmark conditions (a_forced -> b_agent_select -> c_bare_goal).
#
# What runs WHERE:
#   - this GPU job: `generate` (VASP inputs via the LLM + MLIP potentials)
#     and `run` (MLIP relaxations, in-process on the GPU) for every mode.
#   - VASP relaxations: submitted as their own CPU jobs (one per cell)
#     and finish independently.
#   - `collect`: run by hand once the VASP jobs finish (see the tail).

set -euo pipefail

# Repo root — override with `export REPO=...` before sbatch if needed.
REPO="${REPO:-/qfs/people/alle927/SciLink/SciLink}"
cd "$REPO"

# ── env setup (same flow we settled on for interactive sessions) ──
source /people/alle927/scilink_mace_env.sh

# Fail fast on missing config rather than after 12 VASP jobs error out:
#   SCILINK_API_KEY — VASP generation + the agent-select modes call the LLM
#   VASP_PP_PATH    — the generated VASP submit.sbatch assembles POTCAR from it
: "${SCILINK_API_KEY:?set SCILINK_API_KEY (VASP gen + modes b/c need it)}"
: "${VASP_PP_PATH:?set VASP_PP_PATH (the VASP jobs assemble POTCAR from it)}"

PY="$CONDA_PREFIX/bin/python"
MODES=(a_forced b_agent_select c_bare_goal)

vasp_jobs=()
for m in "${MODES[@]}"; do
    echo "=================  mode: $m  ================="

    # generate + run are tolerant so one bad mode doesn't abort the rest.
    if ! "$PY" validation/run_panel.py --mode "$m" --phase generate; then
        echo "!! generate failed for $m — skipping mode" >&2
        continue
    fi
    if ! "$PY" validation/run_panel.py --mode "$m" --phase run; then
        echo "!! MLIP run failed for $m — continuing to VASP submit" >&2
    fi

    # Submit the per-cell VASP jobs for this mode (generated by `generate`).
    for d in validation/results/"$m"/*/vasp; do
        [ -f "$d/submit.sbatch" ] || continue
        cell=$(basename "$(dirname "$d")")
        if jid=$(cd "$d" && sbatch --parsable submit.sbatch); then
            echo "  submitted VASP $m/$cell -> job $jid"
            vasp_jobs+=("$jid")
        else
            echo "!! VASP submit failed for $m/$cell" >&2
        fi
    done
done

echo
echo "MLIP relaxations done. VASP jobs submitted: ${vasp_jobs[*]:-none}"
echo
echo "Once those VASP jobs finish, collect every mode with:"
for m in "${MODES[@]}"; do
    echo "  $PY validation/run_panel.py --mode $m --phase collect"
done
