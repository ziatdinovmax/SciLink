{
  "name": "scilink-webui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "npm run build && rsync -a --delete dist/ ../scilink/server/static/",
    "preview": "vite preview",
    "check:graph": "node --experimental-strip-types scripts/graph_check.ts",
    "check:highlight": "node --experimental-strip-types scripts/highlight_check.ts"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
